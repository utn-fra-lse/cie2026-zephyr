/*
 * ESP32-S3 DevKitC: sw0 ya es el botón BOOT (GPIO0), pero el LED de la
 * placa es un RGB direccionable (WS2812), no un GPIO simple.
 * LED externo: GPIO10 -> resistencia 330 ohm -> LED -> GND.
 */
/ {
	leds {
		compatible = "gpio-leds";
		led_ext: led_ext {
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			label = "LED externo GPIO10";
		};
	};

	aliases {
		led0 = &led_ext;
	};
};
